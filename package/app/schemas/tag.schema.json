{
  "$schema": "./__meta__.schema.json",
  "$id": "https://dev.datannur.com/schemas/tag.schema.json",
  "x-db": "data",
  "title": "tag",
  "description": "Tags",
  "x-description-fr": "Mots clés",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "description": "Primary key of the tag",
        "x-description-fr": "Clé primaire du mot clé"
      },
      "parent_id": {
        "type": ["string", "number", "null"],
        "description": "Key of the parent tag",
        "x-description-fr": "Clé du mot clé parent"
      },
      "doc_ids": {
        "type": ["string", "number", "null"],
        "description": "Keys of related documents",
        "x-description-fr": "Clés des docs liés",
        "pattern": "^([a-zA-Z0-9_-]+(, ?[a-zA-Z0-9_-]+)*)?$",
        "examples": ["id1,id2,id3", "single-id", null]
      },
      "implied_tag_ids": {
        "type": ["string", "number", "null"],
        "description": "Keys of tags also applied when this tag is used",
        "x-description-fr": "Clés des mots clés aussi appliqués quand ce mot clé est utilisé",
        "pattern": "^([a-zA-Z0-9_-]+(, ?[a-zA-Z0-9_-]+)*)?$",
        "examples": ["id1,id2,id3", "single-id", null]
      },
      "propagate_to_parents": {
        "type": ["boolean", "null"],
        "description": "Whether this tag should be propagated to parent business entities",
        "x-description-fr": "Indique si ce mot clé doit être propagé aux entités métiers parentes"
      },
      "name": {
        "type": ["string", "null"],
        "description": "Tag name",
        "x-description-fr": "Nom du mot clé"
      },
      "description": {
        "type": ["string", "null"],
        "description": "Tag description",
        "x-description-fr": "Description du mot clé"
      }
    }
  }
}
